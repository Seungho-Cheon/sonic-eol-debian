<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.google.protobuf</groupId>
	<artifactId>protobuf-java-util</artifactId>
	<version>debian</version>
	<packaging>bundle</packaging>
	<name>Protocol Buffers [Util]</name>
	<description>Utilities for Protocol Buffers</description>
	<dependencies>
		<dependency>
			<groupId>com.google.protobuf</groupId>
			<artifactId>protobuf-java</artifactId>
		<version>debian</version>
		</dependency>
		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
		<version>debian</version>
		</dependency>
		<dependency>
			<groupId>com.google.errorprone</groupId>
			<artifactId>error_prone_annotations</artifactId>
			<version>debian</version>
		</dependency>
		<dependency>
			<groupId>com.google.j2objc</groupId>
			<artifactId>j2objc-annotations</artifactId>
			<version>debian</version>
		</dependency>
		<dependency>
			<groupId>com.google.code.findbugs</groupId>
			<artifactId>jsr305</artifactId>
			<version>debian</version>
		</dependency>
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
			<version>debian</version>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
		<version>debian</version>
		</dependency>
	</dependencies>
	<properties>
		<!-- Use the core proto dir so that we can call the core generation script -->
		<test.proto.dir>../core/src/test/proto</test.proto.dir>
		
			<debian.com.google.code.findbugs.jsr305.originalVersion>3.0.2</debian.com.google.code.findbugs.jsr305.originalVersion>
		
			<debian.com.google.code.gson.gson.originalVersion>2.8.9</debian.com.google.code.gson.gson.originalVersion>
		
			<debian.com.google.errorprone.error_prone_annotations.originalVersion>2.5.1</debian.com.google.errorprone.error_prone_annotations.originalVersion>
		
			<debian.com.google.j2objc.j2objc-annotations.originalVersion>1.3</debian.com.google.j2objc.j2objc-annotations.originalVersion>
		
			<debian.originalVersion>3.21.12</debian.originalVersion>
		
			<debian.package>libprotobuf-java</debian.package>
	</properties>
</project>